{
 "source": "Shoggoth World (the maid cafe: include/text_strings.h.in TEXT_MC_*, text/us/shoggoth_dialogs.h, sound/sequences/us/36_custom_event_katana_fight.s)",
 "lines": {
  "WHO_MARIO": "MARIO?:",
  "WHO_LUIGI": "LUIGI?:",
  "WHO_WARIO": "WARIO?:",
  "WHO_WALUIGI": "WALUIGI?:",
  "WHO_PEACH": "PEACH?:",
  "WHO_YOSHI": "YOSHI?:",
  "WHO_MAID": "MAID:",
  "GASP_1": "Whoa! Through the CEILING?!",
  "GASP_2": "Is that... a second Mario?",
  "GASP_3": "Uh-oh. Two Marios. Awkward.",
  "PULL_1": "He pulled the photo-spot katana!",
  "PULL_2": "That's just a prop... RIGHT?!",
  "PULL_3": "Everyone, draw your replicas!",
  "T_MARIO_1": "Your jump arc is ALL wrong!",
  "T_MARIO_2": "I've watched every speedrun!",
  "T_MARIO_3": "Screen-accurate? LOL. No.",
  "T_MARIO_4": "My overalls are hand-sewn!",
  "T_LUIGI_1": "Bro, your hat's the wrong red.",
  "T_LUIGI_2": "Player 2 has entered the chat!",
  "T_LUIGI_3": "Folded one thousand times!",
  "T_WARIO_1": "WAH! You made me drop my parfait!",
  "T_WARIO_2": "Nobody out-cosplays WARIO!",
  "T_WARIO_3": "This costume cost 300,000 yen!",
  "T_WALUIGI_1": "WAAAH! Waluigi time!",
  "T_WALUIGI_2": "Nobody ever cosplays ME...",
  "T_WALUIGI_3": "I'm tall AND tragic!",
  "T_PEACH_1": "I'm not in another castle!",
  "T_PEACH_2": "My waifu powers are unmatched!",
  "T_PEACH_3": "Princess mode: ON!",
  "T_YOSHI_1": "Yoshi! ...I mean, YOSHI!!",
  "T_YOSHI_2": "This costume is SO hot inside.",
  "T_YOSHI_3": "Flutter jump! ...I can't.",
  "T_ANY_1": "Get the fake!",
  "T_ANY_2": "Did you buy that at a STORE?!",
  "T_ANY_3": "Ugh. A casual.",
  "T_ANY_4": "Nice cosplay... NOT!",
  "HIT_1": "My costume! It's RUINED!",
  "HIT_2": "Not the moustache!",
  "HIT_3": "Foul! That's a cosplay foul!",
  "HIT_4": "The stitching! THE STITCHING!",
  "DOWN_1": "I... was... canon...",
  "DOWN_2": "Tell my followers... I tried...",
  "DOWN_3": "Worth it... for the photos...",
  "DOWN_4": "Delete... my... browser history...",
  "WAVE_2": "Amateurs! Leave it to the pros!",
  "WAVE_3": "Enough. The ORIGINAL will do it.",
  "MAID_1": "Ganbatte, Master!",
  "MAID_2": "Moe moe KYUN!",
  "MAID_3": "Please don't break the cups!",
  "MAID_4": "No katanas in the cafe, please!",
  "MAID_5": "Kyaa! So cool, Master!",
  "PROMPT": "B  PULL THE LEGENDARY BLADE",
  "BOSS_RAGE": "ENOUGH! Maximum cosplay POWER!"
 },
 "dialogs": {
  "challenge": "Hold it right there!\nWhy are you wearing the\nsame costume as me?!\nI worked my whole LIFE to\nlook that good in this\ncostume! Hand-stitched!\nScreen-accurate buttons!\nAnd now you walk in and\nCOPY me! You RUINED my life!\nThat moustache? Glued on.\nAnd your hat is the wrong\nred. Amateur hour.\nNow I have nothing left\nto lose...\nFIGHT ME!",
  "katana": "But I don't cut down the\nunarmed. That's the code.\nThe COSPLAY code.\nThe Legendary Blade of the\nphoto spot is stuck in the\nfloor. Pull it out, fake!",
  "rematch": "YOU again?! The copycat!\nRound two! The blade is\nstill in the floor. Pull\nit out and face me!",
  "defeat": "Impossible... that form...\nthat jump... and those\nsideburns aren't glued...\nWho ARE you?!\n...No. Don't tell me.\nI get it now.\nYou're a cosplayer's\ncosplayer. A method actor.\nA legend.\nTake the star. It was the\nprize for best costume.\nI'll go as Luigi next year."
 },
