w":0,"roll":0,"bparams":0,"bhv":"bhvShFirefly"},{"model":"MODEL_SH_FIREFLY","geo":"tokyo_fauna_firefly_geo","x":5971,"y":211,"z":8931,"pitch":0,"yaw":0,"roll":0,"bparams":0,"bhv":"bhvShFirefly"},{"model":"MODEL_SH_FIREFLY","geo":"tokyo_fauna_firefly_geo","x":-9819,"y":215,"z":5348,"pitch":0,"yaw":0,"roll":0,"bparams":0,"bhv":"bhvShFirefly"},{"model":"MODEL_SH_FIREFLY","geo":"tokyo_fauna_firefly_geo","x":-9880,"y":202,"z":5323,"pitch":0,"yaw":0,"roll":0,"bparams":0,"bhv":"bhvShFirefly"}],"warpNodes":[{"id":"0x8C","level":"LEVEL_DENSHA","area":1,"node":"0x0A"},{"id":"0x8D","level":"LEVEL_TOKYO","area":1,"node":"0x8D"},{"id":"0x40","level":"LEVEL_TOKYO","area":1,"node":"0x41"},{"id":"0x41","level":"LEVEL_TOKYO","area":1,"node":"0x40"},{"id":"0x82","level":"LEVEL_HIGHWAY","area":1,"node":"0x0A"},{"id":"0x83","level":"LEVEL_TOKYO","area":1,"node":"0x83"},{"id":"0xA0","level":"LEVEL_MAIDCAFE","area":1,"node":"0x0A"},{"id":"0xA1","level":"LEVEL_TOKYO","area":1,"node":"0xA1"},{"id":"0xA2","level":"LEVEL_MAIDCAFE","area":1,"node":"0x0C"},{"id":"0x80","level":"LEVEL_KONBINI","area":1,"node":"0x0A"},{"id":"0x81","level":"LEVEL_TOKYO","area":1,"node":"0x81"},{"id":"0x0A","level":"LEVEL_TOKYO","area":1,"node":"0x0A"},{"id":"0x0B","level":"LEVEL_AIRPORT","area":1,"node":"0x21"},{"id":"WARP_NODE_SUCCESS","level":"LEVEL_AIRPORT","area":1,"node":"0x21"},{"id":"WARP_NODE_DEATH","level":"LEVEL_AIRPORT","area":1,"node":"0x21"}],"texts":{"SH_TOKYO_WELCOME":"TOKYO -- Star Gate arrival zone.\nStay behind the yellow line\nand enjoy your stay!","SH_TK_PLAZA":"Welcome to Shibuya! When every\nsignal turns red, the whole\ncrossing walks at once.\nLook up: a steel girder runs\nfrom Q-front's roof out over\nthe crossing. Its fire escape\nis round the east side.","SH_TK_STATION":"The Yamanote line runs right\nacross the island, from here\nto the Observation Tower.\nThe glass lift goes up to the\nplatform. The station master\nis looking for a driver!","SH_TK_ROOFS":"The glitch blew eight red coins\nonto the rooftops! Take the fire\nescape, follow the planks up,\nand the skybridge will lead\nyou to the Observation Tower.","SH_TK_MARKET":"Irasshaimase! Takoyaki!\nMy cat keeps slipping into a\ncourtyard behind the game centre\nin Center Gai. The crates by\nits front are the only way up.","SH_TK_SHRINE":"This shrine is older than the\ncity. Its spring pours off the\nhill into the canal. Walk up\nthrough the gates and make\na wish.","SH_TK_SITE":"Safety first! The crane driver\nleft his lucky star on the hook.\nClimb the frame, cross to the\nmast, and walk out on the jib.\nSlowly!","SH_TK_CANAL":"Houseboats cruise the canal all\nnight. At the east end the water\nfalls right off the island,\ndown into the clouds!","SH_TK_LOT":"This lot has been empty for\nyears. Some nights I hear a\ntrain pull in here.\nThere are no tracks.","SH_TK_DRIFT_CHALLENGE":"Oi. Plumber. You lost? This\ncorner is mine. I'm the DRIFT\nKING -- every night I own the\nShuto. Three laps. Nobody has\never beaten me. You really\nthink YOU can beat the DRIFT\nKING?\n//Race!///No licence...","SH_TK_YAKUZA":"The boss takes the C1 loop\nflat out. Doesn't brake,\ndoesn't blink. Nobody sees\nanything but his tail lights.","SH_TK_DENSHA":"Ah, Mario! Just in time. Our driver\non the Hoshigaoka Line is off sick.\nThree stops through the paddies,\nover the river, down to the sea.\nStop on the yellow marks and keep\nto the timetable...\nWill you drive?\n//Drive!//Not now"}}