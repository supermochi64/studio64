{
  "name": "studio64",
  "version": "0.1.1-beta",
  "license": "MIT",
  "description": "Make your own Super Mario 64 in the browser: a level editor, story, sound studio and playable export, with an optional AI assistant",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node tools/start.mjs",
    "serve": "node server/index.js",
    "catalog": "python3 tools/gen_catalog.py",
    "build:engine": "node tools/build_engine.mjs",
    "setup": "node tools/start.mjs",
    "samples": "node tools/make_all_samples.mjs",
    "shoggoth:refresh": "node tools/shoggoth/refresh.mjs",
    "shoggoth:check": "node tools/shoggoth/check_shipped.mjs",
    "test": "node tests/run.mjs",
    "test:smoke": "node tests/run.mjs --smoke",
    "test:ai": "node tests/run.mjs --ai -j 1",
    "test:all": "node tests/run.mjs --all",
    "test:noai": "node tests/run.mjs --noai"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
